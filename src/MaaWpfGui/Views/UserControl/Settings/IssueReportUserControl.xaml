<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.IssueReportUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:IssueReportUserControlModel}}"
    d:DesignWidth="650"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel
            MaxWidth="450"
            HorizontalAlignment="Center"
            Visibility="{c:Binding 'NewVersionFoundInfo.Length + NewResourceFoundInfo.Length > 0',
                                   Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}">
            <controls:TextBlock Text="{Binding NewVersionFoundInfo, Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}" Visibility="{c:Binding 'NewVersionFoundInfo.Length > 0', Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}" />
            <controls:TextBlock Text="{Binding NewResourceFoundInfo, Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}" Visibility="{c:Binding 'NewResourceFoundInfo.Length > 0', Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}" />
            <controls:TextBlock
                Margin="5,0,5,5"
                HorizontalAlignment="Center"
                Block.TextAlignment="Center"
                Text="{DynamicResource CheckUpdateBeforeReportingIssue}"
                TextWrapping="Wrap" />
        </StackPanel>
        <controls:TextBlock
            MaxWidth="450"
            Margin="5"
            HorizontalAlignment="Center"
            Block.TextAlignment="Center"
            Text="{DynamicResource CheckHelpBeforeReportingIssue}"
            TextWrapping="Wrap"
            Visibility="{c:Binding 'NewVersionFoundInfo.Length + NewResourceFoundInfo.Length == 0',
                                   Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}" />
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 左列：问题反馈渠道 + 操作说明 -->
            <StackPanel
                Grid.Column="0"
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <controls:TextBlock
                    Margin="5,5,5,10"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    Text="{DynamicResource IssueReportLeftTitle}" />
                <controls:TextBlock Margin="5" HorizontalAlignment="Center">
                    <Hyperlink
                        Cursor="Hand"
                        NavigateUri="{Binding Source={x:Static constants:MaaUrls.HelpUri}}"
                        TextDecorations="None">
                        <TextBlock Text="{DynamicResource Help}" />
                    </Hyperlink>
                </controls:TextBlock>
                <controls:TextBlock Margin="5" HorizontalAlignment="Center">
                    <Hyperlink
                        Command="{s:Action SetAcknowledgedNightlyWarning}"
                        Cursor="Hand"
                        NavigateUri="{Binding Source={x:Static constants:MaaUrls.GitHubIssues}}"
                        TextDecorations="None">
                        <TextBlock Text="{DynamicResource Issue}" />
                    </Hyperlink>
                </controls:TextBlock>
                <Separator Margin="5,10" />
                <controls:TextBlock
                    MaxWidth="180"
                    Margin="5"
                    HorizontalAlignment="Center"
                    Block.TextAlignment="Center"
                    Foreground="Gray"
                    Text="{DynamicResource IssueReportLeftHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <!-- 右列：诊断选项 + 操作按钮组 -->
            <StackPanel
                Grid.Column="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <Grid Margin="5,2" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <controls:TextBlock
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource DiagnosticDateRange}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource DiagnosticReportTooltipDateRange}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        Width="140"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding DateRangeOptions}"
                        SelectedValue="{Binding DiagnosticDateRange}"
                        SelectedValuePath="Value" />
                </Grid>
                <StackPanel Margin="5,2" Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="{DynamicResource DiagnosticIncludeConfig}"
                        IsChecked="{Binding IncludeConfig}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource DiagnosticIncludeConfigTip}" />
                </StackPanel>
                <StackPanel Margin="5,2" Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="{DynamicResource DiagnosticIncludeCache}"
                        IsChecked="{Binding IncludeCache}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource DiagnosticIncludeCacheTip}" />
                </StackPanel>
                <StackPanel Margin="5,2" Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="{DynamicResource DiagnosticIncludeCustomResource}"
                        IsChecked="{Binding IncludeCustomResource}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource DiagnosticIncludeCustomResourceTip}" />
                </StackPanel>
                <Grid Margin="5,4" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Command="{s:Action GenerateSupportPayload}"
                        Content="{DynamicResource GenerateDiagnosticReport}"
                        IsEnabled="{Binding IsNotBusy}" />
                    <controls:TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="{Binding BusyStatusText}" />
                </Grid>
                <StackPanel Margin="5,2" Orientation="Horizontal">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{s:Action OpenDebugFolder}"
                        Content="{DynamicResource OpenDebugFolder}" />
                </StackPanel>
                <StackPanel Margin="5,2" Orientation="Horizontal">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{s:Action ClearImageCache,
                                           Target={x:Type settings_vms:IssueReportUserControlModel}}"
                        Content="{DynamicResource ClearImageCache}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource ClearImageCacheTip}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
